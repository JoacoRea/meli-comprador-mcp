# Mercado Libre OAuth app (developers.mercadolibre.com.ar). Run `pnpm auth`
# once to authorize; tokens are stored OUTSIDE the repo and renewed automatically.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://example.com/meli-callback
# Optional: token store location (default ~/.config/meli-comprador-mcp/tokens.json)
MELI_TOKEN_STORE=
# Optional: set to false if your ML app does not have PKCE enabled and auth fails.
MELI_PKCE=

# Optional static fallback, used only when the token store is empty. Never renewed.
MERCADOLIBRE_ACCESS_TOKEN=

# Web price enrichment (optional). When APIFY_TOKEN is set, the server recovers
# live website prices for catalog products that have no API buy-box price and
# returns them inline (price_source: "web"). One shared token for all agents —
# this is NOT the Mercado Libre OAuth token.
APIFY_TOKEN=
APIFY_ML_ACTOR=sourabhbgp~mercadolibre-scraper
# Per-scrape timeout. Keep strictly below the MCP gateway timeout (Bifrost = 60s).
APIFY_TIMEOUT_MS=45000
# Per-call timeout for the best-effort seller/installments product-detail scrape
# in find_offers_for_product_query; a slow page degrades to the search price+link.
WEB_DETAIL_TIMEOUT_MS=20000
# Max web offers returned per find_offers_for_product_query call (capped at 5).
SCRAPE_LIMIT=3
SCRAPE_CACHE_TTL_MS=600000
